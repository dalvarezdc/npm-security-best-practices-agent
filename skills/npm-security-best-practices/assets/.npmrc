# npm security best practices — hardened baseline (14-day cooldown)
# Canonical source for this skill. Agents must MERGE these keys into an existing
# .npmrc — never overwrite a file that already has registry scopes or other settings.
# Source: https://github.com/dalvarezdc/npm-security-best-practices-agent
#
# Global alternative: npm config set <key> <value> for each setting below.

# SECURITY (P01): Do not run lifecycle scripts (postinstall, preinstall, etc.)
# Prevents arbitrary code execution during package installation.
ignore-scripts=true

# SECURITY (P02): Reject git-source dependencies (git+ssh://, git+https://, etc.)
# Requires npm CLI 11.10.0+. Values: all (default) | root | none
allow-git=none

# SECURITY (P03): Block packages published less than 14 days ago.
# Newly published versions are a primary attack vector — malicious releases are
# often removed within days. Requires npm CLI 11+.
min-release-age=14
