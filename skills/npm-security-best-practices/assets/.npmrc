# npm security best practices — hardened baseline
# Source: https://github.com/dalvarezdc/npm-security-best-practices-agent
#
# Copy this file to the root of your project (or merge into your existing .npmrc).
# For global config, run: npm config set <key> <value> for each setting below.

# SECURITY (#1): Do not run any lifecycle scripts (postinstall, preinstall, etc.)
# Prevents arbitrary code execution during package installation.
ignore-scripts=true

# SECURITY (#2): Reject git-source dependencies (git+ssh://, git+https://, etc.)
# Requires npm CLI 11.10.0+. Values: all (default) | root | none
allow-git=none

# SECURITY (#3): Block packages published less than 30 days ago.
# Newly published versions are a primary attack vector — malicious versions
# are typically discovered and removed within hours or days.
# Requires npm CLI 11+.
min-release-age=30
